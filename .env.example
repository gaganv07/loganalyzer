# Supabase Project Credentials

# 1. Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Server-side Privileged Credential (RECOMMENDED for Python backend applications)
# The service_role secret key bypasses Row Level Security (RLS) on private storage buckets.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Standard / Anonymous Credential (ALTERNATIVE option)
# If using SUPABASE_KEY (anon key), you MUST apply Storage RLS policies in Supabase SQL Editor
# scoped to bucket_id = 'application-logs' to grant upload and download permissions.
SUPABASE_KEY=your-supabase-api-key-here

# 4. Storage Bucket Name
SUPABASE_BUCKET=application-logs
